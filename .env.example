# Telegram Bot API token from @BotFather (required).
TELEGRAM_BOT_TOKEN=

# Optional comma-separated chat ids allowed to receive traffic through this
# bridge. When set, send/edit/getChat and inbound updates are restricted to
# these chats. Empty = no chat allowlist.
ALLOWED_CHAT_IDS=

# Optional inbound classification for passwords/tokens/webhooks/admin internals
# and NSFW content. Default is off; set to 1/true/yes/on for untrusted groups.
SAFETY_STRICT=0

# Optional local directory for button id mapping / claim_message_tap state.
# Defaults to a per-user cache under the OS temp/cache location.
# MCP_TELEGRAM_DATA_DIR=
