# Telegram Bot API token from @BotFather (required). Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids. Empty denies every chat (fail closed).
ALLOWED_CHAT_IDS=

# Set to 1/true/yes/on only when you intend to accept every chat.
# Ignored when ALLOWED_CHAT_IDS is non-empty. Startup warns on stderr.
ALLOW_ALL_CHATS=0

# Heuristic labels on inbound updates (secrets, sexual content, a few
# override phrases). Default is on. Set to 0/false/no/off to disable.
# This does not stop prompt injection. See SAFETY.md.
SAFETY_STRICT=1

# Optional bounds. Unset keeps the defaults (4096 chars, 65536 bytes).
# MAX_INBOUND_CHARS=4096
# MAX_UPDATE_BYTES=65536

# Optional rates as count/seconds. "off" disables that limit.
# INBOUND_CHAT_RATE=60/60
# INBOUND_GLOBAL_RATE=120/60
# INBOUND_POLL_RATE=30/60
# OUTBOUND_CHAT_RATE=20/60
# OUTBOUND_GLOBAL_RATE=60/60

# Optional local directory for button id mapping / claim_message_tap state.
# Created with mode 0700; state files written with mode 0600 when the OS allows.
# Defaults to a per-user data/cache path (see SAFETY.md).
# MCP_TELEGRAM_BRIDGE_DATA_DIR=
# Legacy alias still accepted:
# MCP_TELEGRAM_DATA_DIR=
